<Window x:Class="DesktopOrbit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:DesktopOrbit.Models"
        mc:Ignorable="d"
        Title="Titanium Orbital Launcher"
        Width="1200"
        Height="900"
        MinWidth="1000"
        MinHeight="780"
        Background="#FF030405"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.Background>
            <SolidColorBrush Color="#FF030405" />
        </Grid.Background>
        <MediaElement x:Name="RadioPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop" Volume="0.72" Visibility="Collapsed" />

        <Image x:Name="CircuitWallpaper"
               Source="pack://application:,,,/DesktopOrbit;component/Assets/circuit-wallpaper-v1.png"
               Stretch="UniformToFill"
               Opacity="0.43"
               IsHitTestVisible="False"
               RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="WallpaperScale" ScaleX="1.03" ScaleY="1.03" />
                    <TranslateTransform x:Name="WallpaperTranslate" X="-8" Y="-5" />
                </TransformGroup>
            </Image.RenderTransform>
            <Image.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="WallpaperScale" Storyboard.TargetProperty="ScaleX" From="1.03" To="1.10" Duration="0:0:28" />
                            <DoubleAnimation Storyboard.TargetName="WallpaperScale" Storyboard.TargetProperty="ScaleY" From="1.03" To="1.10" Duration="0:0:28" />
                            <DoubleAnimation Storyboard.TargetName="WallpaperTranslate" Storyboard.TargetProperty="X" From="-16" To="16" Duration="0:0:34" />
                            <DoubleAnimation Storyboard.TargetName="WallpaperTranslate" Storyboard.TargetProperty="Y" From="-8" To="10" Duration="0:0:29" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Image.Triggers>
        </Image>
        <Rectangle Fill="#B506090B" IsHitTestVisible="False" />
        <Ellipse Width="520" Height="520" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-120,-120,0" Fill="#22FF7A00" IsHitTestVisible="False">
            <Ellipse.Effect><BlurEffect Radius="90" /></Ellipse.Effect>
            <Ellipse.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded"><BeginStoryboard><Storyboard RepeatBehavior="Forever" AutoReverse="True"><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.18" To="0.52" Duration="0:0:4.5" /></Storyboard></BeginStoryboard></EventTrigger>
            </Ellipse.Triggers>
        </Ellipse>
        <Ellipse Width="420" Height="420" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-130,0,0,-130" Fill="#183DE7F3" IsHitTestVisible="False">
            <Ellipse.Effect><BlurEffect Radius="100" /></Ellipse.Effect>
            <Ellipse.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded"><BeginStoryboard><Storyboard RepeatBehavior="Forever" AutoReverse="True"><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.12" To="0.40" Duration="0:0:6.5" /></Storyboard></BeginStoryboard></EventTrigger>
            </Ellipse.Triggers>
        </Ellipse>

        <!-- Hairline brushed-steel grain over the deep-black foundation. -->
        <Rectangle IsHitTestVisible="False" Opacity="0.28">
            <Rectangle.Fill>
                <DrawingBrush TileMode="Tile" Viewport="0,0,1,7" ViewportUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <GeometryDrawing Brush="Transparent">
                            <GeometryDrawing.Pen>
                                <Pen Brush="#183D454A" Thickness="0.55" />
                            </GeometryDrawing.Pen>
                            <GeometryDrawing.Geometry>
                                <LineGeometry StartPoint="0,0.5" EndPoint="1,0.5" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle Height="2" Margin="94,75,24,0" VerticalAlignment="Top" IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#006F7A80" Offset="0" />
                    <GradientStop Color="#A0C1C9CC" Offset="0.24" />
                    <GradientStop Color="#FF52E6EF" Offset="0.52" />
                    <GradientStop Color="#526E777C" Offset="0.82" />
                    <GradientStop Color="#006E777C" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="76" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="0" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="68" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.RowSpan="2" Background="#F207090A" BorderBrush="#66535C61" BorderThickness="0,0,1,0">
                <DockPanel Margin="0,18,0,18">
                    <Border DockPanel.Dock="Top"
                            Width="48"
                            Height="48"
                            Margin="0,10,0,24"
                            HorizontalAlignment="Center"
                            CornerRadius="18"
                            Background="{StaticResource TitaniumBrush}"
                            BorderBrush="{StaticResource TitaniumEdgeBrush}"
                            BorderThickness="1.2">
                        <Viewbox Margin="10">
                            <Canvas Width="24" Height="24">
                                <Ellipse Width="24" Height="24" Stroke="#FF83F5FC" StrokeThickness="1.3" />
                                <Ellipse Width="14" Height="14" Canvas.Left="5" Canvas.Top="5" Stroke="#FF83F5FC" StrokeThickness="1.3" />
                                <Ellipse Width="4" Height="4" Canvas.Left="10" Canvas.Top="10" Fill="#FF83F5FC" />
                            </Canvas>
                        </Viewbox>
                    </Border>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Width="48" Height="48" Background="#331BE0EE" BorderBrush="#5531EAF7">
                            <TextBlock Text="⌂" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <Button Width="48" Height="48" Margin="0,12,0,0" Background="#221B1E24" BorderBrush="#22384557">
                            <TextBlock Text="◫" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <Button Width="48" Height="48" Margin="0,12,0,0" Background="#221B1E24" BorderBrush="#22384557">
                            <TextBlock Text="◉" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <Button Width="48" Height="48" Margin="0,12,0,0" Background="#221B1E24" BorderBrush="#22384557">
                            <TextBlock Text="⚙" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center">
                        <Button Width="48" Height="48" Background="#221B1E24" BorderBrush="#22384557">
                            <TextBlock Text="?" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <Button Width="48" Height="48" Margin="0,12,0,0" Background="#22FF6670" BorderBrush="#33FF8C93">
                            <TextBlock Text="⏻" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Grid.ColumnSpan="2" Background="#F207090B" BorderBrush="#66535C61" BorderThickness="0,0,0,1">
                <Grid Margin="26,0,26,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="TITANIUM ORBITAL" FontSize="20" FontWeight="Bold" Foreground="#FFE4EAEC" />
                        <TextBlock Text="  LAUNCHER" FontSize="20" FontWeight="Light" Foreground="#FF55E7EF" />
                        <Rectangle Width="1" Height="18" Margin="20,0,20,0" Fill="#333E4655" />
                        <TextBlock Text="Dashboard" FontSize="20" FontWeight="SemiBold" Foreground="#FF34D7E4" />
                        <TextBlock Text="Resources" Margin="26,0,0,0" FontSize="18" Foreground="#FF848D99" />
                        <TextBlock Text="Terminal" Margin="26,0,0,0" FontSize="18" Foreground="#FF848D99" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⌁" FontSize="20" Foreground="#FF7E8795" Margin="0,0,20,0" />
                        <TextBlock Text="▮" FontSize="20" Foreground="#FF7E8795" Margin="0,0,20,0" />
                        <TextBlock Text="⚙" FontSize="20" Foreground="#FF7E8795" Margin="0,0,18,0" />
                        <Border Width="38" Height="38" CornerRadius="19" Background="#FF1A2130" BorderBrush="#223FE7F5" BorderThickness="1" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Grid.Column="1" Margin="26,14,26,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="TITANIUM ORBITAL CONTROL" FontSize="22" FontWeight="Bold" Foreground="#FFF1F4F5" />
                        <TextBlock Margin="0,3,0,0" Text="Rotating app dial  •  worldwide radio  •  tactile detent control" FontSize="11" Foreground="#FF8D989E" />
                    </StackPanel>
                    <Border x:Name="RadioMonitor" Visibility="Collapsed" HorizontalAlignment="Right" Width="172" Height="48" Padding="12,7" CornerRadius="12" Background="#E80B0E10" BorderBrush="#8061E8EF" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Rectangle x:Name="Eq1" Width="4" Height="9" Fill="#FF56E1E8" Margin="0,0,3,0" />
                                <Rectangle x:Name="Eq2" Width="4" Height="20" Fill="#FF56E1E8" Margin="0,0,3,0" />
                                <Rectangle x:Name="Eq3" Width="4" Height="13" Fill="#FFFF9E18" Margin="0,0,3,0" />
                                <Rectangle x:Name="Eq4" Width="4" Height="27" Fill="#FF56E1E8" Margin="0,0,3,0" />
                                <Rectangle x:Name="Eq5" Width="4" Height="16" Fill="#FFFF9E18" Margin="0,0,3,0" />
                                <Rectangle x:Name="Eq6" Width="4" Height="23" Fill="#FF56E1E8" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="RADIO LIVE" FontSize="10" FontWeight="Black" Foreground="#FF61E8EF" />
                                <TextBlock x:Name="RadioMonitorStation" FontSize="9" Foreground="#FFB4BDC1" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel HorizontalAlignment="Center" Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding OrbitModeLabel}" FontSize="14" FontWeight="Bold" Foreground="#FF9EA7AB" Margin="0,8,18,0" />
                        <StackPanel Orientation="Horizontal">
                            <Button Click="PreviousOrbitPage_Click" Content="◀" Padding="12,8" Margin="10,0,4,8" />
                            <TextBlock Margin="8,9,8,0" FontSize="14" Foreground="#FF9CA7B8" Text="{Binding OrbitPageLabel}" />
                            <Button Click="NextOrbitPage_Click" Content="▶" Padding="12,8" />
                        </StackPanel>
                    </DockPanel>

                    <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid x:Name="DialSurface" Width="580" Height="580" Cursor="Hand"
                              MouseLeftButtonDown="DialSurface_MouseLeftButtonDown"
                              MouseMove="DialSurface_MouseMove"
                              MouseLeftButtonUp="DialSurface_MouseLeftButtonUp"
                              MouseLeave="DialSurface_MouseLeave">
                            <Ellipse Width="580" Height="580" Stroke="#FF0A0C0D" StrokeThickness="30" Fill="#F207090A">
                                <Ellipse.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="9" Opacity="0.8" Color="#FF000000" /></Ellipse.Effect>
                            </Ellipse>
                            <Ellipse Width="560" Height="560" Stroke="{StaticResource TitaniumFaceBrush}" StrokeThickness="22" />
                            <Ellipse Width="530" Height="530" Stroke="#FF16191B" StrokeThickness="4" />

                            <ItemsControl ItemsSource="{Binding OrbitItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas Width="580" Height="580" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:OrbitNode}">
                                        <StackPanel Width="112">
                                            <Button Width="96"
                                                    Height="96"
                                                    HorizontalAlignment="Center"
                                                    Click="OrbitItem_Click"
                                                    Tag="{Binding}"
                                                    ToolTip="{Binding Subtitle}"
                                                    BorderThickness="1.2">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource DialNodeButtonStyle}">
                                                        <Setter Property="Background" Value="{StaticResource TitaniumFaceBrush}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource TitaniumEdgeBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource CyanTitaniumBrush}" />
                                                                <Setter Property="BorderBrush" Value="#FF65E8EF" />
                                                                <Setter Property="BorderThickness" Value="3" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <Border Width="58" Height="58" CornerRadius="29" Background="#50101416" BorderBrush="#6059E5ED" BorderThickness="1">
                                                    <Grid>
                                                        <Image Width="42" Height="42" Stretch="Uniform" Source="{Binding IconPath, Converter={StaticResource PathIconConverter}}" />
                                                        <TextBlock Text="{Binding Glyph}" FontSize="16" FontWeight="Black" Foreground="#FF06272A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </Button>
                                            <TextBlock Margin="0,8,0,0"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="#FFE2DFE7"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       MaxHeight="28"
                                                       Text="{Binding DisplayName}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Foreground" Value="#FF61E8EF" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Width="176"
                                    Height="176"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    CornerRadius="88"
                                    Background="#FF080A0B"
                                    BorderBrush="{StaticResource TitaniumFaceBrush}"
                                    BorderThickness="12">
                                <StackPanel VerticalAlignment="Center" Margin="5">
                                    <TextBlock HorizontalAlignment="Center" FontSize="9" Foreground="#FFB7C0C4" Text="◉  24H LIVE" />
                                    <TextBlock HorizontalAlignment="Center"
                                               Margin="0,2,0,0"
                                               FontSize="22"
                                               FontWeight="Light"
                                               FontFamily="Segoe UI Light"
                                               Foreground="#FFFFD24A"
                                               Text="{Binding CurrentTimeText}" />
                                    <TextBlock HorizontalAlignment="Center"
                                               Margin="0,2,0,0"
                                               FontSize="14"
                                               Foreground="#FFF1F4F5"
                                               Text="{Binding CurrentDateText}" />
                                    <TextBlock HorizontalAlignment="Center" Margin="8,2,8,0" FontSize="10" FontWeight="Bold" Foreground="#FF61E8EF" TextAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding SelectedOrbitName}" />
                                    <TextBlock HorizontalAlignment="Center" Margin="8,0,8,0" FontSize="8" Foreground="#FFB0B8BC" TextAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding SelectedOrbitSubtitle}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                    <StackPanel Grid.Row="2" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="AppsModeButton" Click="AppsMode_Click" Content="APPS" Padding="20,8" Style="{StaticResource Cyan3DButtonStyle}" />
                            <Button x:Name="RadioModeButton" Click="RadioMode_Click" Content="RADIO" Padding="20,8" />
                        </StackPanel>
                        <TextBlock HorizontalAlignment="Center" Margin="0,2,0,0" FontSize="11" Foreground="#FF9EA7AB" Text="Drag anywhere on the ring — the item facing the top becomes active." />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <Button Click="RefreshIndex_Click"
                            Content="Launch Search"
                            Padding="20,12"
                            Style="{StaticResource Cyan3DButtonStyle}" />
                    <Button Click="OrganizeDesktop_Click"
                            Content="Organize Desktop"
                            Padding="20,12"
                            Background="#FF27252D"
                            BorderBrush="#33424A5B" />
                    <Button Click="AddApp_Click" Content="Add App" Padding="14,12" />
                    <Button Click="AddFolder_Click" Content="Add Folder" Padding="14,12" />
                    <Button Click="ChooseBackground_Click" Content="Background" Padding="14,12" />
                    <Button Click="ResetBackground_Click" Content="Default" Padding="14,12" />
                    <Button Click="HideOrbit_Click" Content="Hide" Padding="14,12" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Grid.Column="2" Margin="0,16,18,18" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="1.15*" />
                </Grid.RowDefinitions>

                <Border Background="#F20B0D0F" BorderBrush="#66535C61" BorderThickness="1" CornerRadius="18" Padding="16">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="SYSTEM LOAD" FontSize="14" FontWeight="Black" Foreground="#FF74DDE9" />
                            <TextBlock DockPanel.Dock="Right" Text="⚙" FontSize="16" Foreground="#FF74DDE9" />
                        </DockPanel>

                        <TextBlock Margin="0,12,0,0" Text="CPU" FontSize="12" FontWeight="Bold" Foreground="#FFD7D8DD" />
                        <Grid Margin="0,10,0,0">
                            <Border Height="8" CornerRadius="4" Background="#FF2B2F37" />
                            <Border Height="8" Width="102" HorizontalAlignment="Left" CornerRadius="4" Background="#FF81F1F8" />
                        </Grid>
                        <TextBlock HorizontalAlignment="Right" Margin="0,6,0,0" Text="24%" FontSize="14" FontWeight="Bold" Foreground="#FF81F1F8" />

                        <TextBlock Margin="0,10,0,0" Text="RAM" FontSize="12" FontWeight="Bold" Foreground="#FFD7D8DD" />
                        <Grid Margin="0,10,0,0">
                            <Border Height="8" CornerRadius="4" Background="#FF2B2F37" />
                            <Border Height="8" Width="192" HorizontalAlignment="Left" CornerRadius="4" Background="#FFB68BFF" />
                        </Grid>
                        <TextBlock HorizontalAlignment="Right" Margin="0,6,0,0" Text="48%" FontSize="14" FontWeight="Bold" Foreground="#FFB68BFF" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" Margin="0,18,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Background="#F20B0D0F" BorderBrush="#66535C61" BorderThickness="1" CornerRadius="18" Padding="20">
                        <StackPanel>
                            <TextBlock Text="APP DIRECTORY" FontSize="14" FontWeight="Black" Foreground="#FFDCE3E6" />
                            <TextBlock Margin="0,8,0,0" Foreground="#FF94A4B7" Text="Search for apps, folders, and files instantly." TextWrapping="Wrap" />
                            <TextBox Margin="0,14,0,0" Height="42" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,10,0,0" Foreground="#FF98A7BA" Text="{Binding StatusText}" />
                            <WrapPanel Margin="0,16,0,0">
                                <Button Click="OpenManagedRoot_Click" Tag="Shortcuts" Content="{Binding ManagedShortcutsCount, StringFormat=Shortcuts ({0})}" />
                                <Button Click="OpenManagedRoot_Click" Tag="Folders" Content="{Binding ManagedFoldersCount, StringFormat=Folders ({0})}" />
                                <Button Click="OpenManagedRoot_Click" Tag="Files" Content="{Binding ManagedFilesCount, StringFormat=Files ({0})}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Margin="0,14,0,0" Background="#F20B0D0F" BorderBrush="#66535C61" BorderThickness="1" CornerRadius="18" Padding="20">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="RESULTS" FontSize="13" FontWeight="Black" Foreground="#FFB7C0C4" Margin="0,0,0,12" />
                            <ListBox x:Name="SearchResultsList"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ItemsSource="{Binding SearchResults}"
                                     MouseDoubleClick="SearchResults_MouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:LauncherItem}">
                                        <Border Margin="0,0,0,8"
                                                Padding="10"
                                                CornerRadius="16"
                                                Background="#66191C22"
                                                BorderBrush="#22384557"
                                                BorderThickness="1">
                                            <DockPanel>
                                                <Border Width="40" Height="40" CornerRadius="12" Background="#3318D8E6" Margin="0,0,10,0">
                                                    <Image Width="28"
                                                           Height="28"
                                                           Stretch="Uniform"
                                                           Source="{Binding TargetPath, Converter={StaticResource PathIconConverter}}" />
                                                </Border>
                                                <StackPanel>
                                                    <TextBlock FontSize="14" FontWeight="Bold" Foreground="#FFF1EEF3" Text="{Binding DisplayName}" />
                                                    <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="#FF7F8A97" Text="{Binding Subtitle}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Add to Orbit"
                                                  Click="AddSelectedSearchResultToOrbit_Click" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Margin="0,18,0,0" Background="#F20B0D0F" BorderBrush="#80616B70" BorderThickness="1" CornerRadius="18" Padding="20">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <DockPanel>
                                <TextBlock Text="WORLD RADIO" FontSize="14" FontWeight="Black" Foreground="#FFDCE3E6" />
                                <Ellipse DockPanel.Dock="Right" Width="8" Height="8" Fill="#FFFF8A18" Margin="0,4,0,0" />
                            </DockPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                <Button Content="WORLD" Tag="WORLD" Click="RadioRegion_Click" Padding="9,4" FontSize="10" />
                                <Button Content="EUROPE" Tag="EUROPE" Click="RadioRegion_Click" Padding="9,4" FontSize="10" />
                                <Button Content="UK" Tag="UK" Click="RadioRegion_Click" Padding="9,4" FontSize="10" />
                            </StackPanel>
                            <TextBlock Margin="0,6,0,0" Text="Search by station name from the worldwide directory." Foreground="#FF8D989E" TextWrapping="Wrap" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Height="40" Text="{Binding RadioSearchText, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Margin="8,0,0,0" Padding="16,8" Content="TUNE" Click="SearchRadio_Click" Style="{StaticResource Amber3DButtonStyle}" />
                            </Grid>
                            <DockPanel Margin="0,8,0,10">
                                <TextBlock Text="{Binding RadioStatusText}" Foreground="#FF9AA5AA" FontSize="11" />
                                <Button DockPanel.Dock="Right" Content="STOP" Padding="10,3" Margin="0" FontSize="10" Click="StopRadio_Click" />
                            </DockPanel>
                        </StackPanel>
                        <ListBox x:Name="RadioStationsList"
                                 ItemsSource="{Binding RadioStations}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  MouseDoubleClick="RadioStations_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:RadioStation}">
                                    <Border Margin="0,0,0,7"
                                            Padding="11,8"
                                            CornerRadius="8"
                                            Background="#CC15191B"
                                            BorderBrush="#405E686D"
                                            BorderThickness="1">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="17" Background="{StaticResource TitaniumBrush}" BorderBrush="{StaticResource TitaniumEdgeBrush}" BorderThickness="1" Margin="0,0,10,0">
                                                <Ellipse Width="10" Height="10" Fill="#FFFF8A18" />
                                            </Border>
                                            <StackPanel>
                                                <TextBlock FontSize="13" FontWeight="Bold" Foreground="#FFF1F4F5" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="#FF8D989E" Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
