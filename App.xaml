<Application x:Class="DesktopOrbit.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:DesktopOrbit.Converters">
    <Application.Resources>
        <converters:PathIconConverter x:Key="PathIconConverter" />
        <SolidColorBrush x:Key="OrbitBackgroundBrush" Color="#FF030405" />
        <SolidColorBrush x:Key="OrbitPanelBrush" Color="#F20B0D0F" />
        <SolidColorBrush x:Key="OrbitPanelAltBrush" Color="#E6161A1E" />
        <SolidColorBrush x:Key="OrbitBorderBrush" Color="#66778088" />
        <SolidColorBrush x:Key="OrbitTextBrush" Color="#FFF2F5F6" />
        <SolidColorBrush x:Key="OrbitSubtleBrush" Color="#FF8D989E" />
        <LinearGradientBrush x:Key="TitaniumBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF30363A" Offset="0" />
            <GradientStop Color="#FF111416" Offset="0.20" />
            <GradientStop Color="#FF252A2E" Offset="0.48" />
            <GradientStop Color="#FF090B0C" Offset="0.72" />
            <GradientStop Color="#FF353C40" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="TitaniumEdgeBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFB7C0C4" Offset="0" />
            <GradientStop Color="#FF384147" Offset="0.28" />
            <GradientStop Color="#FF111416" Offset="0.70" />
            <GradientStop Color="#FF6E7B81" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="TitaniumFaceBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFD7DADE" Offset="0" />
            <GradientStop Color="#FFA9ADB2" Offset="0.08" />
            <GradientStop Color="#FF7C8085" Offset="0.22" />
            <GradientStop Color="#FF55585C" Offset="0.50" />
            <GradientStop Color="#FF7C8085" Offset="0.78" />
            <GradientStop Color="#FFA9ADB2" Offset="0.92" />
            <GradientStop Color="#FFD7DADE" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CyanTitaniumBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFB9F2F5" Offset="0" />
            <GradientStop Color="#FF6FE0E6" Offset="0.08" />
            <GradientStop Color="#FF3AA3A9" Offset="0.22" />
            <GradientStop Color="#FF226E73" Offset="0.50" />
            <GradientStop Color="#FF3AA3A9" Offset="0.78" />
            <GradientStop Color="#FF6FE0E6" Offset="0.92" />
            <GradientStop Color="#FFB9F2F5" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AmberGlassBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFFFD78C" Offset="0" />
            <GradientStop Color="#FFFF9D14" Offset="0.16" />
            <GradientStop Color="#FF8B3C00" Offset="0.45" />
            <GradientStop Color="#FF5A2300" Offset="0.60" />
            <GradientStop Color="#FFE66D00" Offset="0.86" />
            <GradientStop Color="#FFFFC35C" Offset="1" />
        </LinearGradientBrush>
        <DrawingBrush x:Key="KnurledOverlayBrush" TileMode="Tile" Viewport="0,0,5,5" ViewportUnits="Absolute" Opacity="0.22">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent" Geometry="M 0,5 L 5,0"><GeometryDrawing.Pen><Pen Brush="#FFFFFFFF" Thickness="0.55" /></GeometryDrawing.Pen></GeometryDrawing>
                    <GeometryDrawing Brush="Transparent" Geometry="M 0,0 L 5,5"><GeometryDrawing.Pen><Pen Brush="#FF000000" Thickness="0.55" /></GeometryDrawing.Pen></GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource OrbitTextBrush}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource OrbitTextBrush}" />
            <Setter Property="Background" Value="{StaticResource TitaniumFaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource TitaniumEdgeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Base" Margin="0,6,0,0" CornerRadius="999" Background="#FF101112" BorderBrush="#FF050606" BorderThickness="1">
                                <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="6" Opacity="0.55" Color="#FF000000" /></Border.Effect>
                            </Border>
                            <Border x:Name="Face" Margin="0,0,0,6" CornerRadius="999" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <Rectangle Margin="3" RadiusX="999" RadiusY="999" Fill="{StaticResource KnurledOverlayBrush}" />
                                    <Border Margin="7,1,7,0" Height="12" VerticalAlignment="Top" CornerRadius="999">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#22FFFFFF" Offset="0" />
                                                <GradientStop Color="#EFFFFFFF" Offset="0.22" />
                                                <GradientStop Color="#55FFFFFF" Offset="0.64" />
                                                <GradientStop Color="#BBFFFFFF" Offset="0.88" />
                                                <GradientStop Color="#11FFFFFF" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}" />
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="BorderBrush" Value="#FFE6ECEF" />
                                <Setter TargetName="Face" Property="Margin" Value="0,-2,0,8" />
                                <Setter TargetName="Base" Property="Margin" Value="0,8,0,-2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="Margin" Value="0,5,0,1" />
                                <Setter TargetName="Base" Property="Opacity" Value="0.45" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Face" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Cyan3DButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource CyanTitaniumBrush}" />
            <Setter Property="Foreground" Value="#FF06272A" />
            <Setter Property="BorderBrush" Value="#FF9CF8FC" />
        </Style>
        <Style x:Key="Amber3DButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AmberGlassBrush}" />
            <Setter Property="Foreground" Value="#FF2B1600" />
            <Setter Property="BorderBrush" Value="#FFFFDC94" />
        </Style>
        <Style x:Key="DialNodeButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Margin="0,4,0,0" Fill="#FF090A0B" Stroke="#FF020303" StrokeThickness="1">
                                <Ellipse.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="6" Opacity="0.88" /></Ellipse.Effect>
                            </Ellipse>
                            <Ellipse x:Name="DialFace" Margin="0,0,0,4" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="{TemplateBinding BorderThickness}" />
                            <Ellipse Margin="7,4,7,0" VerticalAlignment="Top" Height="13" Fill="#38FFFFFF" />
                            <ContentPresenter Margin="8,5,8,9" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="DialFace" Property="Margin" Value="0,3,0,1" /></Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DialFace" Property="Stroke" Value="#FFE8EEF0" />
                                <Setter TargetName="DialFace" Property="Margin" Value="0,-2,0,6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource OrbitTextBrush}" />
            <Setter Property="Background" Value="#CC101827" />
            <Setter Property="BorderBrush" Value="{StaticResource OrbitBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Foreground" Value="{StaticResource OrbitTextBrush}" />
            <Setter Property="Background" Value="#55131D2D" />
            <Setter Property="BorderBrush" Value="{StaticResource OrbitBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Application.Resources>
</Application>
